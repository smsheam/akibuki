rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /rooms/{roomId} {
      allow read, write: if true;

      match /players/{playerId} {
        allow read, write: if true;
      }

      match /strokes/{strokeId} {
        allow read, write: if true;
      }

      match /chat/{messageId} {
        allow read, write: if true;
      }

      match /secrets/{secretId} {
        allow read, write: if true;
      }
    }
  }
}
